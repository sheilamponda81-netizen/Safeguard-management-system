# Env vars for running the STATIC E2E suite locally (e2e/static/**),
# which needs no real Supabase project -- these are placeholder values
# only, purely so src/lib/supabase.ts's own startup guard doesn't throw
# when Playwright's webServer builds and previews the app.
#
# Usage: cp .env.test.example .env.local
#
# For the AUTHENTICATED suite (e2e/authenticated/**), see e2e/fixtures.ts
# for the full list of E2E_* vars needed -- those require a real staging
# Supabase project and 4 seeded test accounts, and are NOT placeholder
# values.

VITE_SUPABASE_URL=https://test-placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=test-placeholder-anon-key
